# =====================================================================
# Construction ERP — Supabase environment variables
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# Then paste the SAME values into Vercel:
#   Project → Settings → Environment Variables
#   Apply the same values to all three environments
#   (Production / Preview / Development).
#
# Where to find these values
# ---------------------------------------------------------------------
# Supabase Dashboard → Project → ⚙ Project Settings → API
#   • Project URL     → VITE_SUPABASE_URL
#   • anon public key → VITE_SUPABASE_ANON_KEY
#
# The current project is `pexqlkjlefildktjgrha`, so the URL looks like
#   https://pexqlkjlefildktjgrha.supabase.co
#
# Security note
# ---------------------------------------------------------------------
# The anon key is INTENDED to be public — it ships in the browser
# bundle. Supabase RLS (tied to the `authenticated` role) is what
# protects your data, not the secrecy of this key. Never paste the
# service_role key here — that one stays on the server.
#
# Vite exposes ONLY environment variables prefixed with `VITE_` to the
# client. Anything without that prefix is server-side only.
# =====================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
